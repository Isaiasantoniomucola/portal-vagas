# Endereço da API visto pelo navegador (em produção, com nginx: /api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Endereço do site (usado no sitemap e nos metadados)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Endereço da API visto pelo servidor Next.js (em Docker: http://api:4000/api)
API_URL=http://localhost:4000/api
